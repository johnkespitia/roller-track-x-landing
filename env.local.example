# Copia este archivo a .env.local para desarrollo local
# Los valores aquí son solo para desarrollo - NO los subas a git

# Google Analytics 4 (opcional en desarrollo)
NEXT_PUBLIC_GA_ID=

# Base URL local
NEXT_PUBLIC_BASE_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# Leads — Skate Manager API (Laravel)
# ---------------------------------------------------------------------------
# Endpoint público para enviar leads (escuelas, sponsors, contacto, etc.)
# En dev: docker compose de skate-manager expone 8000
# En prod: https://api.rollertrackx.com/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_LEADS_ENDPOINT=/public/leads

# ---------------------------------------------------------------------------
# Base de datos MySQL — solo se usa en build time
# (lectura de deportistas aprobados, escuelas, contenido dinámico)
# NO se expone al cliente. Las variables NO llevan NEXT_PUBLIC_
# ---------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3308
DB_DATABASE=skate_manager
DB_USERNAME=skate
DB_PASSWORD=skate
